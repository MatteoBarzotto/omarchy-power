<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>omarchy-power</vendor>
  <vendor_url>https://github.com/MatteoBarzotto/omarchy-power</vendor_url>

  <action id="org.omarchy.power1.set-profile">
    <description>Change the power profile, fan mode or cooler boost</description>
    <message>Authentication is required to change this laptop's power settings</message>
    <defaults>
      <!-- Sitting at the machine is authorisation enough: this is the same
           class of action as changing screen brightness, and a password prompt
           on every keypress would make the TUI unusable. -->
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.omarchy.power1.set-charge-threshold">
    <description>Change the battery charge threshold</description>
    <message>Authentication is required to change the battery charge threshold</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
