pkgbase = omarchy-power
	pkgdesc = Power profiles, fan modes, thermals and charge limits for Linux laptops
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/MatteoBarzotto/omarchy-power
	install = omarchy-power.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
	depends = dbus
	depends = polkit
	depends = systemd
	optdepends = power-profiles-daemon: follow the active profile instead of setting it by hand
	optdepends = upower: apply a different power level on battery
	optdepends = msi-ec-dkms: the MSI backend needs attributes the in-kernel msi_ec does not expose
	options = !debug
	backup = etc/omarchy-power/config.toml
	source = omarchy-power-0.2.0.tar.gz::https://github.com/MatteoBarzotto/omarchy-power/archive/v0.2.0.tar.gz
	sha256sums = d8cf859a18396563b23b6ed4cf9000a13fced9a9f133d572fb029dc07025d33c

pkgname = omarchy-power
